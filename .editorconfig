root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Files where an ecosystem standard mandates a specific indentation.
[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab

# Rust follows its own standard via rustfmt (4 spaces, matches root default).
