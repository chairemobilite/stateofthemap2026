# Copy this file to .env and fill in the values.
# Frontend (Vite) reads variables prefixed with VITE_; everything else is
# consumed by the Rust backend via `config::load_dotenv()`.

# Bing Maps API key (optional — Bing Aerial basemap is disabled until this is set).
# You can reuse a key from another project (e.g. an iD editor fork).
VITE_BING_API_KEY=

# Backend — GHS-POP pre-filter configuration.
# Minimum estimated population for a candidate bbox to be accepted by the
# automatic pre-filter. Below this threshold the bbox is redrawn.
GHS_POP_MIN=100

# Postgres (+ PostGIS) connection — the backend and the build-grid binary
# resolve their URL as `PG_CONNECTION_STRING_PREFIX + PG_DATABASE`. The
# integration-test harness carves a disposable `PG_DATABASE_TEST_<uuid>`
# database out of the same server per test run, so you only need one
# running Postgres. Adjust the port to match your local setup
# (Postgres.app defaults to 5432; some installs use 5438).
PG_DATABASE=entrance_analyser
PG_DATABASE_TEST=entrance_analyser_test
PG_CONNECTION_STRING_PREFIX=postgres://postgres:@localhost:5432/
