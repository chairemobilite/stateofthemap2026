# Copy this file to .env and fill in the values.
# Frontend (Vite) reads variables prefixed with VITE_; everything else is
# consumed by the Rust backend via `config::load_dotenv()`.

# Bing Maps API key (optional — Bing Aerial basemap is disabled until this is set).
# You can reuse a key from another project (e.g. an iD editor fork).
VITE_BING_API_KEY=

# Backend — GHS-POP pre-filter configuration.
# Minimum estimated population for a candidate bbox to be accepted by the
# automatic pre-filter. Below this threshold the bbox is redrawn. The
# dual-raster build (--built-volume) also keeps cells whose built
# volume crosses --min-built-volume regardless of population, so
# purely-industrial blocks still land in the grid.
GHS_POP_MIN=100

# Postgres (+ PostGIS) connection — the backend and the build-grid binary
# resolve their URL as `PG_CONNECTION_STRING_PREFIX + PG_DATABASE`. The
# integration-test harness carves a disposable `PG_DATABASE_TEST_<uuid>`
# database out of the same server per test run, so you only need one
# running Postgres. Adjust the port to match your local setup
# (Postgres.app defaults to 5432; some installs use 5438).
PG_DATABASE=entrance_analyser
PG_DATABASE_TEST=entrance_analyser_test
PG_CONNECTION_STRING_PREFIX=postgres://postgres:@localhost:5432/

# Backend — POI picker / focus map overrides (all optional).
# POI_TAGS_PATH points at the YAML the picker reads; defaults to the
# checked-in `entranceAnalyser/config/poi_tags.yml`, resolved at build
# time relative to the backend crate so the binary works from any cwd.
# OVERPASS_URL points at the Overpass interpreter the backend POSTs to;
# defaults to the public overpass-api.de endpoint. Point this at your
# own mirror or a community alternate for heavy batches. Include the
# full path through `/api/interpreter`.
# POI_FOCUS_RADIUS_M is the `around:` buffer (metres) used by the
# /poi_focus endpoint to fetch buildings + entrances around the picked
# POI. 150 m covers a city block; widen for car-oriented contexts,
# narrow for dense cores. Cached results echo the radius they were
# fetched with, so changing this affects new picks only.
# OSM_EDITOR_URL is a URL template the focus map's right-click menu
# uses to open the OSM editor at a clicked location. `{lat}`,
# `{lon}`, and `{zoom}` placeholders are substituted client-side.
# Defaults to the iD editor on osm.org; override to point at a
# self-hosted iD/RapiD fork or JOSM remote-control endpoint.
# POI_TAGS_PATH=/absolute/path/to/poi_tags.yml
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# POI_FOCUS_RADIUS_M=150
# OSM_EDITOR_URL=https://www.openstreetmap.org/edit#map={zoom}/{lat}/{lon}
