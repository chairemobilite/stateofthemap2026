# =====================================================================
# Required — Postgres connection.
# =====================================================================
# Split into prefix + per-db name so the same server hosts both the
# long-lived app db and the integration-test db.
PG_CONNECTION_STRING_PREFIX=postgres://postgres:@localhost:5432/
PG_DATABASE=entrance_analyser
PG_DATABASE_TEST=entrance_analyser_test

# =====================================================================
# Optional — overrides for the POI picker. Uncomment and edit only if
# the defaults below don't fit your setup.
# =====================================================================

# Path to the POI tag config (groups + exceptions). Defaults to the
# checked-in `entranceAnalyser/config/poi_tags.yml`, resolved at build
# time relative to the backend crate so the binary works from any cwd.
# POI_TAGS_PATH=/absolute/path/to/poi_tags.yml

# Overpass endpoint the picker POSTs to. Default is the public
# overpass-api.de interpreter; point this at your own mirror or one of
# the community alternates for heavy batches. The full path including
# `/api/interpreter` is required.
# OVERPASS_URL=https://overpass-api.de/api/interpreter
