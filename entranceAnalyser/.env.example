# Postgres connection — split into prefix + per-db name so the same
# server hosts both the long-lived app db and the integration-test db.
PG_CONNECTION_STRING_PREFIX=postgres://postgres:@localhost:5432/
PG_DATABASE=entrance_analyser
PG_DATABASE_TEST=entrance_analyser_test

# Path to the POI tag config consumed by the analysis runner.
# Defaults to `entranceAnalyser/config/poi_tags.yml` (resolved relative
# to the process's current directory) when unset.
# POI_TAGS_PATH=entranceAnalyser/config/poi_tags.yml

# Overpass endpoint used by the POI picker. Defaults to the public
# overpass-api.de interpreter when unset; point this at a self-hosted
# mirror or one of the community alternates if you're running heavy
# batches.
# OVERPASS_URL=https://overpass-api.de/api/interpreter
